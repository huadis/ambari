{
  "name": "default",
  "description": "default quick links configuration",
  "configuration": {
    "protocol":
    {
      "type":"HTTP_ONLY"
    },

    "links": [
      {
        "name": "livy_server_ui",
        "label": "Livy Server UI",
        "component_name": "LIVY_SERVER",
        "requires_user_name": "false",
        "url": "%@://%@:%@",
        "port":{
          "http_property": "livy.server.port",
          "http_default_port": "8999",
          "https_property": "livy.server.port",
          "https_default_port": "8999",
          "regex": "^(\\d+)$",
          "site": "livy-conf"
        }
      }
    ]
  }
}
