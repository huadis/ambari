{
  "name": "default",
  "description": "Default theme for Dinky service",
  "configuration": {
    "layouts": [
      {
        "name": "default",
        "tabs": [
          {
            "name": "settings",
            "display-name": "Settings",
            "layout": {
              "tab-rows": "1",
              "tab-columns": "2",
              "sections": [
                {
                  "name": "section-database",
                  "display-name": "Database",
                  "row-index": "0",
                  "column-index": "0",
                  "row-span": "1",
                  "column-span": "1",
                  "section-rows": "1",
                  "section-columns": "1",
                  "subsections": [
                    {
                      "name": "subsection-database-col1",
                      "row-index": "0",
                      "column-index": "1",
                      "row-span": "1",
                      "column-span": "1"
                    }
                  ]
                },
                {
                  "name": "section-flink",
                  "display-name": "Flink",
                  "row-index": "0",
                  "column-index": "1",
                  "row-span": "1",
                  "column-span": "1",
                  "section-rows": "1",
                  "section-columns": "1",
                  "subsections": [
                    {
                      "name": "subsection-flink-col1",
                      "row-index": "0",
                      "column-index": "0",
                      "row-span": "1",
                      "column-span": "1"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    ],
    "placement": {
      "configuration-layout": "default",
      "configs": [
        {
          "config": "application/spring.datasource.database.type",
          "subsection-name": "subsection-database-col1"
        },
        {
          "config": "application/spring.datasource.database.host",
          "subsection-name": "subsection-database-col1"
        },
        {
          "config": "application/spring.datasource.database.port",
          "subsection-name": "subsection-database-col1"
        },
        {
          "config": "application/spring.datasource.database.name",
          "subsection-name": "subsection-database-col1"
        },
        {
          "config": "application/spring.datasource.database.username",
          "subsection-name": "subsection-database-col1"
        },
        {
          "config": "application/spring.datasource.database.password",
          "subsection-name": "subsection-database-col1"
        },
        {
          "config": "application/flink.major.version",
          "subsection-name": "subsection-flink-col1"
        }
      ]
    },
    "widgets": [
      {
        "config": "application/spring.datasource.database.type",
        "widget": {
          "type": "combo"
        }
      },
      {
        "config": "application/spring.datasource.database.host",
        "widget": {
          "type": "text-field"
        }
      },
      {
        "config": "application/spring.datasource.database.port",
        "widget": {
          "type": "text-field"
        }
      },
      {
        "config": "application/spring.datasource.database.name",
        "widget": {
          "type": "text-field"
        }
      },
      {
        "config": "application/spring.datasource.database.username",
        "widget": {
          "type": "text-field"
        }
      },
      {
        "config": "application/spring.datasource.database.password",
        "widget": {
          "type": "password"
        }
      },
      {
        "config": "application/flink.major.version",
        "widget": {
          "type": "combo"
        }
      }
    ]
  }
}
