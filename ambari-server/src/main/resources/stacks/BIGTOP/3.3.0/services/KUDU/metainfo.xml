<metainfo>
    <schemaVersion>2.0</schemaVersion>
    <services>
        <service>
            <name>KUDU</name>
            <displayName>Kudu</displayName>
            <comment>Apache Kudu is an open source distributed data storage engine that makes fast analytics on fast and changing data easy.  </comment>
            <version>1.17.1</version>
            <selection>TECH_PREVIEW</selection>
            <components>
                <component>
                    <name>KUDU_MASTER</name>
                    <displayName>Kudu Master</displayName>
                    <category>MASTER</category>
                    <cardinality>1+</cardinality>
                    <commandScript>
                        <script>scripts/kudu_master.py</script>
                        <scriptType>PYTHON</scriptType>
                        <timeout>10000</timeout>
                    </commandScript>
                </component>
                <component>
                    <name>KUDU_TSERVER</name>
                    <displayName>Kudu Table Server</displayName>
                    <category>SLAVE</category>
                    <cardinality>1+</cardinality>
                    <commandScript>
                        <script>scripts/kudu_tserver.py</script>
                        <scriptType>PYTHON</scriptType>
                        <timeout>10000</timeout>
                    </commandScript>
                    <configFiles>
                        <configFile>
                            <type>xml</type>
                            <fileName>kudu-tserver-env.xml</fileName>
                            <dictionaryName>kudu_tserver-env</dictionaryName>
                        </configFile>
                    </configFiles>
                </component>
            </components>

            <osSpecifics>
                <osSpecific>
                    <osFamily>any</osFamily>
                    <packages>
                        <package>
                            <name>kudu_${stack_version}</name>
                        </package>
                    </packages>
                </osSpecific>
            </osSpecifics>    

            <configuration-dependencies>
                <config-type>kudu-env</config-type>
                <config-type>kudu-master-env</config-type>
                <config-type>kudu-tserver-env</config-type>
                <config-type>ranger-kudu-plugin-properties</config-type>
                <config-type>ranger-kudu-audit</config-type>
                <config-type>ranger-kudu-policymgr-ssl</config-type>
                <config-type>ranger-kudu-security</config-type>
            </configuration-dependencies>
            <quickLinksConfigurations>
                <quickLinksConfiguration>
                    <fileName>quicklinks.json</fileName>
                    <default>true</default>
                </quickLinksConfiguration>
            </quickLinksConfigurations>
            <restartRequiredAfterChange>true</restartRequiredAfterChange>
        </service>
    </services>
</metainfo>
