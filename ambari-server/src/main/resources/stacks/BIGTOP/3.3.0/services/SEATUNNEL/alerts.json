{
  "SEATUNNEL": {
    "SEATUNNEL_SERVER": [
      {
        "name": "seatunnel_server_process",
        "label": "Seatunnel Server Process",
        "description": "This host-level alert is triggered if the individual Seatunnel Server  processes cannot be established to be up and listening on the network.",
        "interval": 1,
        "scope": "HOST",
        "enabled": true,
        "source": {
          "type": "PORT",
          "uri": "{{seatunnel-hazelcast/port}}",
          "default_port": 5801,
          "reporting": {
            "ok": {
              "text": "TCP OK - {0:.3f}s response on port {1}"
            },
            "warning": {
              "text": "TCP OK - {0:.3f}s response on port {1}",
              "value": 1.5
            },
            "critical": {
              "text": "Connection failed: {0} to {1}:{2}",
              "value": 5.0
            }
          }
        }
      }
    ]
  }
}