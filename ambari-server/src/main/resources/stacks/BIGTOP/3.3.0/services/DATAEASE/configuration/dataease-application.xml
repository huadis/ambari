<configuration>
    <property>
        <name>dataease_user</name>
        <display-name>DataEase User</display-name>
        <value>dataease</value>
        <property-type>USER</property-type>
        <value-attributes>
            <type>user</type>
            <overridable>false</overridable>
            <user-groups>
                <property>
                    <type>cluster-env</type>
                    <name>user_group</name>
                </property>
            </user-groups>
        </value-attributes>
        <on-ambari-upgrade add="false"/>
    </property>
    <property require-input="true">
        <name>spring.datasource.database.host</name>
        <value>127.0.0.1</value>
        <description>DataEase host ip/hostname</description>
        <on-ambari-upgrade add="true"/>
    </property>
    <property require-input="true">
        <name>spring.datasource.database.port</name>
        <value>3306</value>
        <description>DataEase port</description>
        <property-type>PORT</property-type>
        <on-ambari-upgrade add="true"/>
    </property>
    <property require-input="true">
        <name>spring.datasource.database.name</name>
        <value>dataease</value>
        <description>DataEase Name</description>
        <on-ambari-upgrade add="true"/>
    </property>
    <property require-input="true">
        <name>spring.datasource.database.username</name>
        <value>root</value>
        <description>DataEase UserName</description>
        <on-ambari-upgrade add="true"/>
    </property>
    <property require-input="true">
        <name>spring.datasource.database.password</name>
        <value>Cestc_01</value>
        <property-type>PASSWORD</property-type>
        <description>DataEase Password</description>
        <value-attributes>
            <empty-value-valid>true</empty-value-valid>
            <type>password</type>
        </value-attributes>
        <on-ambari-upgrade add="true"/>
    </property>
    <property>
        <name>dataease_log_dir</name>
        <display-name>DataEase Log directory</display-name>
        <value>/var/log/dataease</value>
        <description>DataEase Log Dir</description>
        <value-attributes>
            <type>directory</type>
        </value-attributes>
        <on-ambari-upgrade add="false"/>
    </property>
    <property>
        <name>dataease_pid_dir</name>
        <display-name>DataEase PID directory</display-name>
        <value>/var/run/dataease</value>
        <description>DataEase Pid Dir</description>
        <value-attributes>
            <type>directory</type>
        </value-attributes>
        <on-ambari-upgrade add="false"/>
    </property>
    <property require-input="true">
        <name>server.port</name>
        <value>8010</value>
        <display-name>Server Port</display-name>
        <on-ambari-upgrade add="true"/>
    </property>
    <property>
        <name>dataease.context</name>
        <value>/</value>
        <description>DataEase Context</description>
        <on-ambari-upgrade add="true"/>
    </property>
</configuration>
