{
  "DATAEASE": {
    "service": [],
    "DATAEASE_SERVER": [
      {
        "name": "dataease_server_port_check",
        "label": "dataease_server_port_check",
        "description": "dataease_server_port_check.",
        "interval": 10,
        "scope": "HOST",
        "source": {
          "type": "PORT",
          "uri": "{{dataease-application/server.port}}",
          "default_port": 8810,
          "reporting": {
            "ok": {
              "text": "TCP OK - {0:.3f}s response on port {1}"
            },
            "warning": {
              "text": "TCP OK - {0:.3f}s response on port {1}",
              "value": 1.5
            },
            "critical": {
              "text": "Connection failed: {0} to {1}:{2}",
              "value": 5.0
            }
          }
        }
      }
    ]
  }
}
