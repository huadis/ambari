#!/bin/bash

STREAMPARK_HOME=$(dirname "$(cd "$(dirname "$0")" && pwd)")

. /usr/lib/bigtop-utils/bigtop-detect-javahome

PID_FILE={{ streampark_pid_filename }}

# Check whether the pid path exists
PID_PATH={{ streampark_pid_dir }}

if [ -d "${PID_PATH}" ];then
    echo "${PID_PATH} is already exist." >> /dev/null
else
    mkdir -p  "${PID_PATH}"
fi

# Check whether the pid file exists
if [ -f "${PID_PATH}/${PID_FILE}" ];then
    echo "${PID_PATH}/${PID_FILE} is already exist." >> /dev/null
else
    touch "${PID_PATH}"/${PID_FILE}
fi

tips() {
  echo ""
  echo "WARNING!!!......Tips, please use command: sh app.sh [start|stop|restart|status].   For example: sh app.sh start  "
  echo ""
  exit 1
}

updatePid() {
  pid=$(ps -ef | grep [S]treamPark  | awk '{print $2}' | head -1)
  echo $pid >"${PID_PATH}"/${PID_FILE}
}

start() {
  updatePid
  if [ -z "$pid" ]; then
    nohup java -Dfile.encoding=utf-8 -Dloader.path=${STREAMPARK_HOME} -Dspring.config.additional-location=${STREAMPARK_HOME}/config/ -XX:+ExitOnOutOfMemoryError -cp . -jar ${STREAMPARK_HOME}/lib/CoreApplication.jar >${STREAMPARK_HOME}/logs/streampark.out 2>&1 &
    echo $! >"${PID_PATH}"/${PID_FILE}
    echo "........................................Start StreamPark Successfully........................................"
  else
    echo "StreamPark pid $pid is in ${PID_PATH}/${PID_FILE}, Please stop first !!!"
  fi
}

stop() {
  updatePid
  pid=$(cat "${PID_PATH}"/${PID_FILE})
  if [ -z $pid ]; then
    echo "StreamPark pid is not exist in ${PID_PATH}/${PID_FILE}"
  else
    kill -9 $pid
    sleep 1
    echo "........................................Stop StreamPark Successfully....................................."
    rm -f "${PID_PATH}"/${PID_FILE}
  fi
}

status() {
  updatePid
  if [ -z $pid ]; then
    echo ""
    echo "Service StreamPark is not running!"
    echo ""
    exit 1
  else
    echo ""
    echo "Service StreamPark is running. It's pid=${pid}"
    echo ""
  fi
}

restart() {
  echo ""
  stop
  start
  echo "........................................Restart Successfully........................................"
}

case "$1" in
"start")
  start
  ;;
"stop")
  stop
  ;;
"status")
  status
  ;;
"restart")
  restart
  ;;
*)
  tips
  ;;
esac
