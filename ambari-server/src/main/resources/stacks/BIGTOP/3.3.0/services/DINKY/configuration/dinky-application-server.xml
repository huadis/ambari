<configuration>
    <property>
        <name>dinky.user</name>
        <value>dinky</value>
        <display-name>Deploy User</display-name>
        <on-ambari-upgrade add="true"/>
    </property>
    <property>
        <name>dinky.group</name>
        <value>dinky</value>
        <display-name>Deploy Group</display-name>
        <on-ambari-upgrade add="true"/>
    </property>
    <property>
        <name>dinky.log.dir</name>
        <display-name>Dinky Log directory</display-name>
        <value>/var/log/dinky</value>
        <description>Dinky Log Dir</description>
        <value-attributes>
            <type>directory</type>
        </value-attributes>
        <on-ambari-upgrade add="true"/>
    </property>
    <property>
        <name>dinky.pid.dir</name>
        <display-name>Dinky PID directory</display-name>
        <value>/var/run/dinky</value>
        <value-attributes>
            <type>directory</type>
        </value-attributes>
        <on-ambari-upgrade add="true"/>
    </property>
    <property require-input="true">
        <name>server.port</name>
        <value>8888</value>
        <display-name>Server Port</display-name>
        <on-ambari-upgrade add="true"/>
    </property>
    <property require-input="true">
        <name>flink.major.version</name>
        <value>1.17</value>
        <description>
            The version of flink major version such as: 1.18, 1.17, 1.16, 1.15, 1.14
        </description>
        <value-attributes>
            <type>value-list</type>
            <entries>
                <entry>
                    <value>1.14</value>
                </entry>
                <entry>
                    <value>1.15</value>
                </entry>
                <entry>
                    <value>1.16</value>
                </entry>
                <entry>
                    <value>1.17</value>
                </entry>
            </entries>
        </value-attributes>
        <on-ambari-upgrade add="true"/>
    </property>
    <property require-input="true">
        <name>spring.datasource.database.type</name>
        <value>mysql</value>
        <description>
            en: The type of database to use. Valid values are mysql, postgresql , you must input the mysql/postgresql
        </description>
        <value-attributes>
            <type>value-list</type>
            <entries>
                <entry>
                    <value>mysql</value>
                    <description>
                        mysql database
                    </description>
                </entry>
                <entry>
                    <value>pgsql</value>
                    <description>
                        postgresql database
                    </description>
                </entry>
            </entries>
        </value-attributes>
        <on-ambari-upgrade add="true"/>
    </property>
    <property require-input="true">
        <name>spring.datasource.database.host</name>
        <value>127.0.0.1</value>
        <description>
            en: DataBase host ip/hostname
        </description>
        <on-ambari-upgrade add="true"/>
    </property>
    <property require-input="true">
        <name>spring.datasource.database.port</name>
        <value>3306</value>
        <description>
            en: DataBase port
        </description>
        <property-type>PORT</property-type>
        <on-ambari-upgrade add="true"/>
    </property>
    <property require-input="true">
        <name>spring.datasource.database.name</name>
        <value>dinky</value>
        <description>
            en: DataBase Name
        </description>
        <on-ambari-upgrade add="true"/>
    </property>
    <property require-input="true">
        <name>spring.datasource.database.username</name>
        <value>dinky</value>
        <description>
            en: DataBase UserName
        </description>
        <on-ambari-upgrade add="true"/>
    </property>
    <property require-input="true">
        <name>spring.datasource.database.password</name>
        <value>dinky1234!2</value>
        <description>
            en: DataBase Password
        </description>
        <property-type>PASSWORD</property-type>
        <on-ambari-upgrade add="true"/>
    </property>
</configuration>
