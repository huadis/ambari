{
  "STREAMPARK": {
    "service": [],
    "STREAMPARK_SERVER": [
      {
        "name": "streampark_server_port_check",
        "label": "streampark_server_port_check",
        "description": "streampark_server_port_check.",
        "interval": 10,
        "scope": "ANY",
        "source": {
          "type": "PORT",
          "uri": "{{ application/server.port }}",
          "default_port": 10000,
          "reporting": {
            "ok": {
              "text": "TCP OK - {0:.3f}s response on port {1}"
            },
            "warning": {
              "text": "TCP OK - {0:.3f}s response on port {1}",
              "value": 1.5
            },
            "critical": {
              "text": "Connection failed: {0} to {1}:{2}",
              "value": 5.0
            }
          }
        }
      }
    ]
  }
}
