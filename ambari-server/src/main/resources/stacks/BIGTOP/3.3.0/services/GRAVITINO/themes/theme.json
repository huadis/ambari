{
  "name": "default",
  "description": "Default theme for Gravitino service",
  "configuration": {
    "layouts": [
      {
        "name": "default",
        "tabs": [
          {
            "name": "settings",
            "display-name": "Settings",
            "layout": {
              "tab-rows": "2",
              "tab-columns": "2",
              "sections": [
                {
                  "name": "section-database",
                  "display-name": "Database",
                  "row-index": "0",
                  "column-index": "0",
                  "row-span": "1",
                  "column-span": "2",
                  "section-rows": "1",
                  "section-columns": "2",
                  "subsections": [
                    {
                      "name": "subsection-database-col1",
                      "row-index": "0",
                      "column-index": "0",
                      "row-span": "1",
                      "column-span": "1"
                    },
                    {
                      "name": "subsection-database-col2",
                      "row-index": "0",
                      "column-index": "1",
                      "row-span": "1",
                      "column-span": "1"
                    }
                  ]
                },
                {
                  "name": "section-cache",
                  "display-name": "Cache",
                  "row-index": "1",
                  "column-index": "0",
                  "row-span": "1",
                  "column-span": "2",
                  "section-rows": "1",
                  "section-columns": "1",
                  "subsections": [
                    {
                      "name": "subsection-cache-col1",
                      "row-index": "0",
                      "column-index": "0",
                      "row-span": "1",
                      "column-span": "1"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    ],
    "placement": {
      "configuration-layout": "default",
      "configs": [
        {
          "config": "gravitino-storage/gravitino.entity.store.relational.jdbcUrl",
          "subsection-name": "subsection-database-col1"
        },
        {
          "config": "gravitino-storage/gravitino.entity.store.relational.jdbcDriver",
          "subsection-name": "subsection-database-col1"
        },
        {
          "config": "gravitino-storage/gravitino.entity.store.relational.jdbcUser",
          "subsection-name": "subsection-database-col2"
        },
        {
          "config": "gravitino-storage/gravitino.entity.store.relational.jdbcPassword",
          "subsection-name": "subsection-database-col2"
        },
        {
          "config": "gravitino-cache/gravitino.cache.enabled",
          "subsection-name": "subsection-cache-col1"
        }
      ]
    },
    "widgets": [
      {
        "config": "gravitino-storage/gravitino.entity.store.relational.jdbcUrl",
        "widget": {
          "type": "text-field"
        }
      },
      {
        "config": "gravitino-storage/gravitino.entity.store.relational.jdbcDriver",
        "widget": {
          "type": "text-field"
        }
      },
      {
        "config": "gravitino-storage/gravitino.entity.store.relational.jdbcUser",
        "widget": {
          "type": "text-field"
        }
      },
      {
        "config": "gravitino-storage/gravitino.entity.store.relational.jdbcPassword",
        "widget": {
          "type": "password"
        }
      },
      {
        "config": "gravitino-cache/gravitino.cache.enabled",
        "widget": {
          "type": "toggle"
        }
      }
    ]
  }
}
