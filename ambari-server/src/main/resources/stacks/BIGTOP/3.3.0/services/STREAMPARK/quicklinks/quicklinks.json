{
  "name": "default",
  "description": "default quick links configuration",
  "configuration": {
    "protocol":
    {
      "type":"http"
    },

    "links": [
      {
        "name": "StreamPark-ui",
        "label": "StreamPark Web UI",
        "requires_user_name": "false",
        "component_name": "STREAMPARK_SERVER",
        "url": "%@://%@:%@",
        "port":{
          "http_property": "server.port",
          "http_default_port": "10000",
          "regex": "^(\\d+)$",
          "site": "streampark-application"
        }
      }
    ]
  }
}
