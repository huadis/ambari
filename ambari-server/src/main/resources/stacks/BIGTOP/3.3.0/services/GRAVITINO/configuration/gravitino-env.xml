<configuration>
    <property>
        <name>gravitino.user</name>
        <display-name>Deploy User</display-name>
        <value>gravitino</value>
        <description>Gravitino user.</description>
        <property-type>USER</property-type>
        <value-attributes>
            <type>user</type>
            <overridable>false</overridable>
            <user-groups>
                <property>
                    <type>cluster-env</type>
                    <name>user_group</name>
                </property>
            </user-groups>
        </value-attributes>
        <on-ambari-upgrade add="false"/>
    </property>
    <property>
        <name>gravitino.group</name>
        <display-name>Deploy Group</display-name>
        <value>gravitino</value>
        <property-type>GROUP</property-type>
        <description>Gravitino user group.</description>
    </property>
    <property>
        <name>env-content</name>
        <display-name>Gravitino Env template</display-name>
        <description>This is the jinja template for gravitino-env.sh file</description>
        <value>
GRAVITINO_VERSION=1.0.0

. /usr/lib/bigtop-utils/find_javahome 17

echo -e "JAVA_HOME=${JAVA_HOME}"

export GRAVITINO_HOME={{ gravitino_home }}
export GRAVITINO_CONF_DIR={{ gravitino_home }}/conf
export GRAVITINO_LOG_DIR={{ gravitino_home }}/logs
        </value>
        <value-attributes>
            <type>content</type>
            <empty-value-valid>false</empty-value-valid>
            <show-property-name>false</show-property-name>
        </value-attributes>
        <on-ambari-upgrade add="true"/>
    </property>
</configuration>
